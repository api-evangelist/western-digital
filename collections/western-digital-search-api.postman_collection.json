              "content": "Returns files within a specified parent folder, enabling directory traversal.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sdk",
                "v2",
                "filesSearch",
                "parents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of parent folder IDs to search within. Use \"root\" for the root folder."
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Pagination token."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results."
