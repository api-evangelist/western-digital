          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://wdc.auth0.com/authorize?client_id=<string>&redirect_uri=<uri>&response_type=code&scope=<string>&state=<string>",
              "protocol": "https",
              "host": [
                "wdc",
                "auth0",
                "com"
              ],
              "path": [
                "authorize"
              ],
              "query": [
                {
                  "description": "(Required) OAuth 2.0 client identifier.",
                  "key": "client_id",
                  "value": "<string>"
                },
                {
                  "description": "(Required) URI to redirect to after authorization.",
                  "key": "redirect_uri",
                  "value": "<uri>"
                },
                {
                  "description": "(Required) Must be \"code\" for authorization code flow.",
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "description": "Space-separated list of scopes. Supported: openid, email, profile, nas_read_only, nas_read_write.",
                  "key": "scope",
                  "value": "<string>"
                },
                {
                  "description": "CSRF protection state parameter.",
                  "key": "state",
                  "value": "<string>"
                }
